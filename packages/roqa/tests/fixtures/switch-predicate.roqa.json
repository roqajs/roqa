							]
						},
						{
							"test": {
								"kind": "binary",
								"op": ">=",
								"left": { "kind": "state-read", "name": "score" },
								"right": { "kind": "literal", "value": 70 }
							},
							"render": [
								{
									"kind": "element",
									"tag": "span",
									"attributes": {
										"class": { "kind": "literal", "value": "silver" }
