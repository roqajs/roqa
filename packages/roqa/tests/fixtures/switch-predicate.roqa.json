{
	"version": 1,
	"tagName": "score-badge",
	"name": "ScoreBadge",

	"state": [
		{
			"kind": "value",
			"name": "score",
			"initial": 0
		}
	],
	"actions": [],
	"props": [],
	"attrs": [],
	"emits": [],
	"lifecycle": {},

	"render": [
		{
			"kind": "element",
			"tag": "div",
			"attributes": {},
			"events": [],
			"children": [
				{
					"kind": "switch",
